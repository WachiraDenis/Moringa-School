function togglePositionStatement() {
    const text = document.getElementById("colPositionStatement");
    if (text.classList.contains("line-clamp-3")) {
        text.classList.remove("line-clamp-3");
        text.classList.add("line-clamp-none");
        document.getElementById("lnkPositionStatement").textContent = "Read Less";
    } else {
        text.classList.remove("line-clamp-none");
        text.classList.add("line-clamp-3");
        document.getElementById("lnkPositionStatement").textContent = "Read More";
    }
}

